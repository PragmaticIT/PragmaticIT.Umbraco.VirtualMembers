<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!--
      Umbraco.Cms.Web.Common is intentionally pinned to a version range starting at 15.0.0
      for NuGet package compatibility. Do not update it without verifying the full version matrix.
      This setting disables the "package updates available" indicator in Visual Studio for this project only.
    -->
    <add key="CheckForPackageUpdates" value="false" />
  </config>
</configuration>
