@using Umbraco.Cms.Web.Common.PublishedModels
@using Microsoft.Extensions.Options
@using System.Security.Claims
@using PragmaticIT.Umbraco.VirtualMembers.Options
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@inject IOptions<VirtualMembersOptions> VirtualMembersOptions
@{
    Layout = null;

    var currentSite = ViewData["CurrentSite"] as string;

    //System.Diagnostics.Debugger.Break();

    var vmAuth     = VirtualMembersOptions.Value.Auth;
    var vmIdentity = Context.User.Identity as ClaimsIdentity;
    var isVmUser   = Context.User.Identity?.IsAuthenticated == true;
    var vmName     = vmIdentity?.FindFirst(ClaimTypes.Name)?.Value;
    var vmEmail    = vmIdentity?.FindFirst(ClaimTypes.Email)?.Value;
    var vmGroups   = vmIdentity?.FindAll(ClaimTypes.Role).Select(c => c.Value).ToList() ?? [];
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Virtual Users POC</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Bootstrap 5 CDN -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
        crossorigin="anonymous"
    />

    <style>
        /* Kolory nagl�wk�w dla r�znych site'�w */
        .header-public {
            background-color: #ffffff;
        }

        .header-orga {
            background: linear-gradient(90deg, #0d6efd 0%, #4dabf7 100%);
            color: #ffffff;
        }

        .header-orgb {
            background: linear-gradient(90deg, #198754 0%, #63e6be 100%);
            color: #ffffff;
        }

        .header-public .navbar-brand,
        .header-public .nav-link {
            color: #212529;
        }

        .header-orga .navbar-brand,
        .header-orgb .navbar-brand {
            color: #ffffff;
        }

        .header-orga .nav-link,
        .header-orgb .nav-link {
            color: #f8f9fa;
        }

        .header-orga .nav-link:hover,
        .header-orgb .nav-link:hover {
            color: #ffffff;
        }

        body {
            background-color: #f8f9fa;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="
        navbar navbar-expand-lg navbar-light border-bottom shadow-sm
        @(
            currentSite == "OrgA" ? "header-orga" :
            currentSite == "OrgB" ? "header-orgb" :
            "header-public"
        )">
        <div class="container">
            <a class="navbar-brand fw-semibold" href="/">
                Virtual Users POC
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-end" id="mainNavbar">
                <ul class="navbar-nav mb-2 mb-lg-0 me-3">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/org-a">Organization A</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/org-b">Organization B</a>
                    </li>
                </ul>

                @if (isVmUser)
                {
                    <span class="navbar-text me-3 small">
                        Signed in as <strong>@(vmName ?? vmEmail)</strong>
                        @foreach (var group in vmGroups)
                        {
                            <span class="ms-1 badge bg-light text-dark">@group</span>
                        }
                    </span>
                    <form method="post" action="@vmAuth.LogoutPath" class="m-0 d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-light btn-sm">Sign out</button>
                    </form>
                }
                else
                {
                    <a href="@vmAuth.LoginViewPath" class="btn btn-outline-light btn-sm">
                        Sign in
                    </a>
                }
            </div>
        </div>
    </header>

    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="border-top bg-white py-4 mt-auto">
        <div class="container">
            @if (isVmUser)
            {
                <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center
                            justify-content-between gap-3 mb-3 pb-3 border-bottom">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="text-muted small">Signed in as</span>
                        <strong class="small">@(vmName ?? vmEmail)</strong>
                        @if (!string.IsNullOrEmpty(vmName) && !string.IsNullOrEmpty(vmEmail))
                        {
                            <span class="text-muted small">(@vmEmail)</span>
                        }
                        @foreach (var group in vmGroups)
                        {
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                @group
                            </span>
                        }
                    </div>

                    <form method="post" action="@vmAuth.LogoutPath" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-secondary btn-sm">
                            Sign out
                        </button>
                    </form>
                </div>
            }

            <div class="text-center text-muted small">
                &copy; <span id="year"></span> Virtual Users POC
            </div>
        </div>
    </footer>

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous">
    </script>
    <script>
        document.getElementById("year").textContent = new Date().getFullYear();
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>