{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "HealthChecks": {
        "Notification": {
          "Enabled": true,
          "NotificationMethods": {
            "email": {
              "Recipients": "you@example.com",
              "Enabled": true
            }
          }
        }
      },
      "Global": {
        "Id": "06cd2155-df57-4b71-a4a5-6267d724ee21",
        "Smtp": {
          "From": "noreply@example.com",
          "Host": "your.smtp.host",
         // "Port": 587,
          //"SecureSocketOptions": "StartTls"
        }
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Unattended": {
        "UpgradeUnattended": true
      },
      "Security": {
        "AllowConcurrentLogins": false
      }
    }
  },
  "VirtualMembers": {
    "Auth": {
      "Scheme": "VirtualMembers",
      "CookieName": "VirtualMembers.Auth",
      "LoginPath": "/vapi/login",
      "LogoutPath": "/vapi/logout",
      "CookieLifetimeMinutes": 60,
      "Mode": "OTP"
    },
    "Redirect": {
      "PostLoginRedirectUrl": "/",
      "PostLogoutRedirectUrl": "/"
    },
    "Csv": {
      "Directory": "~/Member Lists",
      "FilePattern": "*.csv",
      "CacheMinutes": 5,
      "Watch": true,
      "WatchFilter": "*.csv",
      "Encoding": "utf-8"
    }
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=|DataDirectory|/Umbraco.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  }
}