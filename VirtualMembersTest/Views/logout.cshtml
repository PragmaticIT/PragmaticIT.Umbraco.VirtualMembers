@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "layout.cshtml";
    ViewData["Title"] = "Signed out";
    ViewData["CurrentSite"] = "Public";

    // Po wylogowaniu mozesz wyczyscic takze ViewData["CurrentUserEmail"] itd.
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-sm-10 col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 text-center">
                    <h1 class="h4 fw-semibold mb-2">You have been signed out</h1>
                    <p class="text-muted mb-4">
                        Your session has ended. You can sign in again to access
                        your organization space.
                    </p>
                    <div class="d-grid gap-2">
                        <a href="/login" class="btn btn-primary">Sign in again</a>
                        <a href="/" class="btn btn-outline-secondary">Go to home page</a>
                    </div>
                </div>
            </div>
            <p class="text-center text-muted small mt-3 mb-0">
                In a real implementation, this page is shown after the session
                is cleared by the authentication pipeline.
            </p>
        </div>
    </div>
</div>