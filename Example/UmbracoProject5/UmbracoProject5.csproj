<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CompressionEnabled>false</CompressionEnabled> <!-- Disable compression. E.g. for umbraco backoffice files. These files should be precompressed by node and not let dotnet handle it -->
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Common\Seed\ContentInstaller.cs" Link="Seed\ContentInstaller.cs" />
    <Compile Include="..\..\Common\Seed\ContentMigrationComposer.cs" Link="Seed\ContentMigrationComposer.cs" />
    <Compile Include="..\..\Common\Seed\ContentMigrationPlan.cs" Link="Seed\ContentMigrationPlan.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\Common\Seed\access-denied.xml" Link="Seed\access-denied.xml" />
    <EmbeddedResource Include="..\..\Common\Seed\home.xml" Link="Seed\home.xml" />
    <EmbeddedResource Include="..\..\Common\Seed\login.xml" Link="Seed\login.xml" />
    <EmbeddedResource Include="..\..\Common\Seed\logout.xml" Link="Seed\logout.xml" />
    <EmbeddedResource Include="..\..\Common\Seed\org-a.xml" Link="Seed\org-a.xml" />
    <EmbeddedResource Include="..\..\Common\Seed\org-b.xml" Link="Seed\org-b.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" Version="17.2.2" />
    <ProjectReference Include="..\..\Source\PragmaticIT.Umbraco.VirtualMembers\PragmaticIT.Umbraco.VirtualMembers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Opt-in to app-local ICU to ensure consistent globalization APIs across different platforms -->
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" Condition="$(RuntimeIdentifier.StartsWith('linux')) or $(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('osx')))" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Member lists\" />
    <Folder Include="Seed\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\Common\Member Lists\Org-A.csv" Link="Member lists\Org-A.csv" />
    <None Include="..\..\Common\Member Lists\Org-B.csv" Link="Member lists\Org-B.csv" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Razor files are needed for the backoffice to work correctly -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
  </PropertyGroup>


</Project>
