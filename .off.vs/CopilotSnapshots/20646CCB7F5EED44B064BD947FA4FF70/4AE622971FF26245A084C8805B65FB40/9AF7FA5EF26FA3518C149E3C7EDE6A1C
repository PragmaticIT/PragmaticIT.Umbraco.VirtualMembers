<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Fallback used locally and in IDE; CI overrides via /p:UmbracoVersion=x.y.z -->
    <UmbracoVersion Condition="'$(UmbracoVersion)' == ''">17.2.2</UmbracoVersion>
    <!-- Oldest Umbraco version the package is compatible with (IPublishedContentCache.GetByIdAsync) -->
    <UmbracoMinVersion>15.0.0</UmbracoMinVersion>
    <!-- NuGet packaging -->
    <PackageId>Pragmatic.Umbraco.VirtualMembers</PackageId>
    <Version>1.0.0</Version>
    <Authors>Pragmatic</Authors>
    <Description>Virtual (passwordless) member authentication for Umbraco CMS — supports CSV-based member providers, OTP, and pluggable custom providers.</Description>
    <PackageTags>umbraco;members;authentication;virtual;csv;otp</PackageTags>
    <PackageProjectUrl>https://github.com/pragmatic-agency/Pragmatic.Umbraco.VirtualMembers</PackageProjectUrl>
    <RepositoryUrl>https://github.com/pragmatic-agency/Pragmatic.Umbraco.VirtualMembers</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Required for Microsoft.AspNetCore.* types (IHttpContextAccessor, IAuthenticationService, etc.) -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Umbraco.Cms.Web.Common — the lightest package that includes:
        - Umbraco.Cms.Core (IComposer, IUmbracoBuilder, IMemberGroupService, IPublicAccessChecker, etc.)
        - UmbracoHelper, IUmbracoApplicationBuilderContext
      Intentionally NOT referencing Umbraco.Cms (meta-package) to avoid pulling in
      Infrastructure, StaticFiles, and other host-only assemblies into the NuGet consumer.
    -->
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="[$(UmbracoVersion), 18.0.0)" />
  </ItemGroup>

</Project>
