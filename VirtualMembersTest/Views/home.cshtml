@using Umbraco.Cms.Web.Common.PublishedModels
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "layout.cshtml";
    ViewData["Title"] = "Home";
    ViewData["CurrentSite"] = "Public";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="text-center mb-4">
                <h1 class="fw-semibold mb-3">Organizations Portal</h1>
                <p class="text-muted mb-0">
                    This is a public landing page. Access to organization spaces
                    is restricted to authorized members only.
                </p>
            </div>

            <div class="row g-4 mt-4">
                <div class="col-md-6">
                    <a href="/org-a" class="text-decoration-none">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <h2 class="h5 fw-semibold mb-2">Organization A</h2>
                                <p class="text-muted mb-0">
                                    Secure workspace for Organization A members.
                                    Content and navigation are tailored to A&rsquo;s users.
                                </p>
                            </div>
                            <div class="card-footer bg-white border-0 pt-0 pb-3 px-3">
                                <span class="text-primary fw-semibold">Enter space &rarr;</span>
                            </div>
                        </div>
                    </a>
                </div>

                <div class="col-md-6">
                    <a href="/org-b" class="text-decoration-none">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <h2 class="h5 fw-semibold mb-2">Organization B</h2>
                                <p class="text-muted mb-0">
                                    Secure workspace for Organization B members.
                                    Shows how the same platform can serve another tenant.
                                </p>
                            </div>
                            <div class="card-footer bg-white border-0 pt-0 pb-3 px-3">
                                <span class="text-primary fw-semibold">Enter space &rarr;</span>
                            </div>
                        </div>
                    </a>
                </div>
            </div>

            <div class="mt-5 text-center text-muted small">
                <p class="mb-1">
                    This POC demonstrates virtual users and organization-scoped access
                    on top of Umbraco.
                </p>
            </div>
        </div>
    </div>
</div>
